# Token from @BotFather
BOT_TOKEN=
# Numeric Telegram ids allowed to use the bot, comma-separated (e.g. from @userinfobot);
# everyone else is ignored
ALLOWED_USER_IDS=
# Optional proxy for Telegram API: socks5://user:pass@host:port or http://user:pass@host:port
PROXY_URL=
# Data directory: SQLite DB (auto_tracker.db), later photos and backups
DATA_DIR=data
# Owner's time zone until it is changed in the bot settings (IANA name)
DEFAULT_TZ=Europe/Moscow
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
